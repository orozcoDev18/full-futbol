# Supabase · Project Settings → Database → Connection string
# Transaction pooler (puerto 6543). Es la que usa Vercel.
DATABASE_URL="postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexión directa (puerto 5432). Solo para crear o cambiar tablas.
DIRECT_URL="postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Firma de la cookie de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="pon-aqui-32-caracteres-aleatorios"

# Organización del panel (se crea sola la primera vez)
ORG_NAME="Liga Amateur Demo"
ORG_SLUG="demo"
